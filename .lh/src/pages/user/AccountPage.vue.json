            "date": 1755872800876,
            "name": "Commit-0",
            "content": "<template>\n  <q-page class=\"profile-page\">\n    <div class=\"page-header\">\n      <h2 class=\"text-h4 q-mb-md\">{{ t('profile') }}</h2>\n      <p class=\"text-body1 q-mb-lg\">{{ t('personalInfo') }}</p>\n    </div>\n\n    <!-- Profile Card -->\n    <q-card class=\"profile-card\" flat bordered>\n      <q-card-section class=\"text-center\">\n        <q-avatar size=\"80px\" class=\"q-mb-md\">\n          <q-icon name=\"account_circle\" size=\"80px\" color=\"primary\" />\n        </q-avatar>\n        <h3 class=\"text-h5\">Nguyễn Văn A</h3>\n        <p class=\"text-grey-6\">CCCD: 123456789</p>\n      </q-card-section>\n    </q-card>\n\n    <!-- Profile Options -->\n    <q-card class=\"q-mt-lg\" flat bordered>\n      <q-card-section>\n        <q-list>\n          <q-item clickable v-ripple>\n            <q-item-section avatar>\n              <q-icon name=\"person\" color=\"primary\" />\n            </q-item-section>\n            <q-item-section>\n              <q-item-label>{{ t('personalInfoTitle') }}</q-item-label>\n              <q-item-label caption>{{ t('personalInfoDesc') }}</q-item-label>\n            </q-item-section>\n            <q-item-section side>\n              <q-icon name=\"chevron_right\" />\n            </q-item-section>\n          </q-item>\n\n          <q-item clickable v-ripple>\n            <q-item-section avatar>\n              <q-icon name=\"security\" color=\"warning\" />\n            </q-item-section>\n            <q-item-section>\n              <q-item-label>{{ t('changePassword') }}</q-item-label>\n              <q-item-label caption>{{ t('changePasswordDesc') }}</q-item-label>\n            </q-item-section>\n            <q-item-section side>\n              <q-icon name=\"chevron_right\" />\n            </q-item-section>\n          </q-item>\n\n          <q-item clickable v-ripple>\n            <q-item-section avatar>\n              <q-icon name=\"notifications\" color=\"info\" />\n            </q-item-section>\n            <q-item-section>\n              <q-item-label>{{ t('notificationsTitle') }}</q-item-label>\n              <q-item-label caption>{{ t('notificationsDesc') }}</q-item-label>\n            </q-item-section>\n            <q-item-section side>\n              <q-icon name=\"chevron_right\" />\n            </q-item-section>\n          </q-item>\n\n          <q-item clickable v-ripple>\n            <q-item-section avatar>\n              <q-icon name=\"help\" color=\"secondary\" />\n            </q-item-section>\n            <q-item-section>\n              <q-item-label>{{ t('helpTitle') }}</q-item-label>\n              <q-item-label caption>{{ t('helpDesc') }}</q-item-label>\n            </q-item-section>\n            <q-item-section side>\n              <q-icon name=\"chevron_right\" />\n            </q-item-section>\n          </q-item>\n        </q-list>\n      </q-card-section>\n    </q-card>\n\n    <!-- Logout Button -->\n    <div class=\"text-center q-mt-lg\">\n      <q-btn\n        color=\"negative\"\n        icon=\"logout\"\n        :label=\"t('logout')\"\n        size=\"lg\"\n        @click=\"logout\"\n      />\n    </div>\n  </q-page>\n</template>\n\n<script setup lang=\"ts\">\nimport { useRouter } from 'vue-router';\nimport { Notify } from 'quasar';\n\nconst router = useRouter();\nconst { t } = useI18n();\n\nconst logout = () => {\n  Notify.create({\n    type: 'positive',\n    message: t('logoutSuccess'),\n    position: 'top'\n  });\n  void router.push({ name: 'auth.login' });\n};\n</script>\n\n<style scoped>\n.profile-page {\n  padding: 24px;\n  background-color: #f5f5f5;\n  min-height: 100vh;\n}\n\n.page-header {\n  margin-bottom: 24px;\n}\n\n.profile-card {\n  border-radius: 12px;\n}\n\n.q-card {\n  border-radius: 12px;\n}\n\n.q-btn {\n  border-radius: 8px;\n  font-weight: 600;\n}\n\n@media (max-width: 768px) {\n  .profile-page {\n    padding: 16px;\n  }\n}\n</style> "
